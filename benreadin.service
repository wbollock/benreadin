[Unit]
Description=BenReadin – Goodreads shelf to Libby availability checker
After=network.target

[Service]
Type=simple
User=benreadin
Group=benreadin

WorkingDirectory=/opt/benreadin
ExecStart=/opt/benreadin/benreadin
EnvironmentFile=/opt/benreadin/.env

Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/benreadin/data
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
