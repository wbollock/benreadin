# Server
PORT=3000
DB_PATH=./data/cache.db

# Cache TTLs (seconds)
CACHE_TTL_LIBRARY_SECONDS=7200    # 2 hours
CACHE_TTL_AMAZON_SECONDS=86400    # 24 hours
CACHE_TTL_BOOK_SECONDS=7200       # 2 hours (full book result cache)

# Concurrency limits
CONCURRENCY_OVERDRIVE=5
CONCURRENCY_AMAZON=3

# Amazon PA-API 5.0 (optional — app works without these, prices won't be shown)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=          # e.g. mysite-20
AMAZON_MARKETPLACE=www.amazon.com
