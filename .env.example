# Server
PORT=3000
DB_PATH=./data/cache.db

# Cache TTLs (seconds)
CACHE_TTL_LIBRARY_SECONDS=7200    # 2 hours
CACHE_TTL_AMAZON_SECONDS=86400    # 24 hours
CACHE_TTL_BOOK_SECONDS=7200       # 2 hours (full book result cache)

# Concurrency limits
CONCURRENCY_OVERDRIVE=5
CONCURRENCY_AMAZON=3

# Amazon PA-API 5.0 (optional — app works without these, prices won't be shown)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=          # e.g. mysite-20
AMAZON_MARKETPLACE=www.amazon.com

# Background prewarm: periodically re-runs seeded + recently used searches so
# results are already cached when returning users search again.
PREWARM_ENABLED=true
PREWARM_INTERVAL_SECONDS=3600     # how often to refresh (1 hour)
PREWARM_ACTIVE_DAYS=10            # keep warming searches used within N days
# Seeds always kept warm, regardless of recent usage.
# Format: userID:shelf:lib1,lib2;userID2:shelf:lib3
PREWARM_SEEDS=97106512:to-read:freelibrary
